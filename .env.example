# Gene Explorer configuration.
# Copy this file to .env and set GROQ_API_KEY. All other keys are optional and
# fall back to the defaults shown here.

# --- Groq (required) ---
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Model and generation (optional; defaults shown) ---
# The default model is a current, production-tier Groq model with reliable
# tool calling. Change MODEL to select a different Groq model from the ENV.
MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
TEMPERATURE=0.0
REASONING_EFFORT=low
SEED=42
MAX_TURNS=6
REQUEST_TIMEOUT_S=30.0

# --- Authentication (optional; empty disables it) ---
# Comma-separated list of accepted API keys, sent as the X-API-Key header.
# Empty means the API is open, which suits local use only. Conversation
# sessions require a key, because sessions are scoped to the caller.
API_KEYS=

# --- Conversation memory (optional; defaults shown) ---
# "memory" keeps history in the process and suits a single instance.
# "redis" shares history across instances and is the production setting.
SESSION_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600
SESSION_MAX_ITEMS=40

# --- Service (optional; defaults shown) ---
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:8501
# CSV_PATH defaults to the packaged dataset. Override only for a custom dataset.
# CSV_PATH=src/gene_explorer/data/gene_dataset.csv
