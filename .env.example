# LLM Provider: groq
LLM_PROVIDER=groq

# Groq API key
GROQ_API_KEY=your_groq_api_key_here

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# CORS Allow List
ALLOWED_ORIGINS=http://localhost:8501

# Dataset Path
CSV_PATH=backend/data/gene_dataset.csv

# Server URL
BACKEND_URL=http://localhost:8000